{
    "manifest_version": 3,
    "name": "写拉松小助手",
    "version": "1.0.17",
    "description": "写拉松小助手 - 支持速记、剪藏、卡片扩展的侧边栏助手",
    "permissions": [
        "activeTab",
        "storage",
        "scripting",
        "sidePanel",
        "downloads",
        "clipboardRead",
        "clipboardWrite",
        "contextMenus",
        "tabs"
    ],
    "host_permissions": [
        "https://api.writeathon.cn/*",
        "<all_urls>"
    ],
    "commands": {
        "clip-selection": {
            "suggested_key": {
                "default": "Alt+S",
                "mac": "Alt+S"
            },
            "description": "剪藏选中内容"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "shortcuts.js"
            ],
            "run_at": "document_end",
            "all_frames": true
        }
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "打开写拉松小助手",
        "default_icon": {
            "16": "icons/logo16.png",
            "32": "icons/logo32.png",
            "48": "icons/logo48.png",
            "128": "icons/logo128.png"
        }
    },
    "side_panel": {
        "default_path": "index.html"
    },
    "icons": {
        "16": "icons/logo16.png",
        "32": "icons/logo32.png",
        "48": "icons/logo48.png",
        "128": "icons/logo128.png"
    }
}